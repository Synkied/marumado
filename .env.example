# Copy to .env and adjust. `make up` creates it for you on first run.

# Folders that hold your projects, comma separated. Each subfolder is a project.
# They are mounted read-only into the container. More can be added in the app.
MARUMADO_PROJECT_DIRS=/projects
# Extra folders to make visible (read-only) without scanning them, so folders
# inside them can be added from the app. Example: /home/me
MARUMADO_MOUNTS=

# 127.0.0.1 = this machine only. Use 0.0.0.0 to open it to your phone/teammates on the LAN.
MARUMADO_BIND=127.0.0.1
MARUMADO_PORT=7878
# The access token browsers ask for (always required, localhost included). Leave empty and Marumado
# makes one on first run (`make access-token` prints it), or set your own: `make token` prints a strong one.
MARUMADO_TOKEN=

# Any long random string (`make secret` prints one).
MARUMADO_SECRET_KEY=change-me-in-dot-env

# Folder buttons. Marumado opens folders in the file manager when it runs natively
# on your desktop (make dev). From Docker, a VM or a server, give a link template
# the browser opens instead; {path} is the folder. Examples:
#   vscode://vscode-remote/ssh-remote+my-vm{path}   VS Code, folder on an SSH host
#   vscode://file{path}                              VS Code, same machine
MARUMADO_OPEN_URL=

# Herdr (coding agents). By default Marumado asks the herdr binary on this machine.
# Agents in a smolvm machine: its name. Works natively and in Docker (`make up` mounts
# your ~/.smolvm and ~/.local/share/smolvm and runs smolvm as you).
MARUMADO_HERDR_SMOLVM=
# Agents in another kind of local VM: a command that runs things inside it. For the live
# terminal it must pass stdin through (e.g. `docker exec -i my-box`).
MARUMADO_HERDR_EXEC=
# Agents in a VM or on another machine: an SSH target with key login (user@host or a
# ~/.ssh/config alias). In Docker, `make up` mounts MARUMADO_SSH_DIR (default ~/.ssh).
MARUMADO_HERDR_SSH=
# Your SSH keys and config, mounted read-only in Docker and copied (as root, private) for ssh to use. Set it (e.g. ~/.ssh) to watch
# other machines from the Machines module; MARUMADO_HERDR_SSH mounts ~/.ssh on its own.
MARUMADO_SSH_DIR=
# Only these keys from it (comma separated, e.g. id_rsa), plus known_hosts; your config is then left out.
# Use it when ssh offers too many keys and servers give up before the right one.
MARUMADO_SSH_KEYS=
# Herdr on this machine but Marumado in Docker: its socket and binary, which `make up`
# mounts. Usually ~/.config/herdr/herdr.sock and ~/.local/bin/herdr (full paths).
MARUMADO_HERDR_SOCKET=
MARUMADO_HERDR_BIN=
# The live agent terminal in the browser: control (type into agents, also from the prompt box on phones; the default),
# observe (watch only) or off (output refreshed every few seconds instead).
# Anyone who can open Marumado can type into your agents: set MARUMADO_TOKEN beyond localhost.
MARUMADO_HERDR_TERMINAL=
